NEXT_PUBLIC_SITE_URL=https://severinosantalucia.dev

# Form contatti (actions/contact.actions.ts) via Resend.
# Senza RESEND_API_KEY il form mostra un errore con l'email diretta.
# RESEND_API_KEY=re_xxx
# Mittente: deve appartenere a un dominio verificato su Resend.
# CONTACT_FROM_EMAIL=form@severinosantalucia.dev
# Destinatario (default: email in lib/data/profile.ts).
# CONTACT_TO_EMAIL=severinosantalucia5@gmail.com

# GitHub API (opzionale).
# Senza token: 60 richieste/ora (unauth) — sufficiente con ISR 1h.
# Con token: 5000 richieste/ora. Crea un classic token con scope "public_repo" su
# https://github.com/settings/tokens e incollalo qui.
# GITHUB_TOKEN=ghp_xxx
